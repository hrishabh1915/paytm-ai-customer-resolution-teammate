{
  "name": "paytm-ai-customer-resolution-teammate",
  "version": "1.0.0",
  "description": "Autonomous Outcome-Driven AI Customer Resolution Teammate for Paytm hackathon (Track 3)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:backend": "npm --workspace=backend run build",
